--- a/util/main-loop.c
+++ b/util/main-loop.c
@@ -37,6 +37,11 @@
 
 #ifndef _WIN32
 #include <sys/wait.h>
+#ifdef __COSMOPOLITAN__
+#include <cosmo.h>
+#include <pthread.h>
