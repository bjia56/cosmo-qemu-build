 #endif
 
 #ifndef _WIN32
@@ -153,11 +158,44 @@
 
 static GArray *gpollfds;
 
+#ifdef __COSMOPOLITAN__
+/*
+ * The guest's 1 kHz PIT needs ~1 ms main-loop wake-ups, but Windows rounds waits
+ * to 15.6 ms (Linux guests with HZ=1000 panic: "IO-APIC + timer doesn't work").
+ * NtSetTimerResolution() alone does not last: clock_nanosleep() cancels the
+ * request when its last sleeper wakes, so keep one thread asleep forever.
+ */
+static void *cosmo_win_timer_holder(void *opaque)
+{
+    struct timespec forever = { .tv_sec = 1000000000 };
+
+    for (;;) {
+        clock_nanosleep(CLOCK_MONOTONIC, 0, &forever, NULL);
+    }
+    return NULL;
+}
+
+static void cosmo_win_hold_timer_resolution(void)
+{
+    pthread_t thread;
+
+    if (pthread_create(&thread, NULL, cosmo_win_timer_holder, NULL) == 0) {
+        pthread_detach(thread);
+    }
+}
+#endif
+
 int qemu_init_main_loop(Error **errp)
 {
     int ret;
     GSource *src;
 
+#ifdef __COSMOPOLITAN__
+    if (IsWindows()) {
+        cosmo_win_hold_timer_resolution();
+    }
+#endif
+
     init_clocks(qemu_timer_notify_cb);
 
     ret = qemu_signal_init(errp);
