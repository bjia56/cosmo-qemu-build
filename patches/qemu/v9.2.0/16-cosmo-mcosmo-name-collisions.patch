@@ -934,7 +934,7 @@ static int cmd_parse_params(const char *data, const char *schema,
     return 0;
 }
 
-static inline int startswith(const char *string, const char *pattern)
+static inline int gdb_startswith(const char *string, const char *pattern)
 {
   return !strncmp(string, pattern, strlen(pattern));
 }
@@ -954,7 +954,7 @@ static bool process_string_cmd(const char *data,
