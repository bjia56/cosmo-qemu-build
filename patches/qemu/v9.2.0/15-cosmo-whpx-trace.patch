+#ifdef __COSMOPOLITAN__
+void whpx_trace_name(const char *name)
+{
+    static const char *target;
+    static bool initialized;
+
+    if (!initialized) {
+        target = getenv("QEMU_WHPX_TRACE");
+        initialized = true;
+    }
+    if (!target || !*target) {
+        return;
+    }
+    if (!strcmp(target, "1")) {
+        fprintf(stderr, "whpx: %s\n", name);
+    } else {
+        /*
+         * Any other value is a file name. Reopen it in append mode for every
+         * line: stdout/stderr redirected to a file can be overwritten by the
+         * crash report, and this way nothing is buffered when a crash happens.
+         */
+        FILE *f = fopen(target, "a");
+
+        if (f) {
+            fprintf(f, "whpx: %s\n", name);
+            fclose(f);
+        }
+    }
+}
+#endif
