+#ifdef __COSMOPOLITAN__
+/*
+ * Set QEMU_WHPX_TRACE=1 to print the name of every WHP call just before it is
+ * made; the last line before a crash names the API that was running.
+ */
+void whpx_trace_name(const char *name);
+#define WHPX_CALL(fn) (whpx_trace_name(#fn), whp_dispatch.fn)
+#else
+#define WHPX_CALL(fn) whp_dispatch.fn
+#endif
+
 bool init_whp_dispatch(void);
 
 typedef enum WHPFunctionList {
