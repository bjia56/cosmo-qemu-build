diff --git a/hw/9pfs/9p-util-cosmo.c b/hw/9pfs/9p-util-cosmo.c
new file mode 100644
index 0000000..fd04ab6
--- /dev/null
+++ b/hw/9pfs/9p-util-cosmo.c
@@ -0,0 +1,176 @@
+/*
+ * 9p utilities (Cosmopolitan implementation). One binary runs on every host, so
+ * host differences are decided at run time. Only Linux has the xattrs that
+ * "mapped-xattr" needs; "mapped-file" and "none" need only POSIX calls.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cosmo-linux-syscall.h"
+#include "9p-util.h"
+
+#include <cosmo.h>
+#include <libc/sysv/consts/nr.h>
+
+/* errno values differ on macOS and Windows; the guest is always Linux, so translate */
+int cosmo_errno_to_dotl(int err)
+{
+    int i;
+    const struct {
+        int linux_errno;
+        int host_errno;
+    } map[] = {
+        { 1, EPERM }, { 2, ENOENT }, { 3, ESRCH }, { 4, EINTR },
+        { 5, EIO }, { 6, ENXIO }, { 7, E2BIG }, { 8, ENOEXEC },
+        { 9, EBADF }, { 10, ECHILD }, { 11, EAGAIN }, { 12, ENOMEM },
+        { 13, EACCES }, { 14, EFAULT }, { 16, EBUSY }, { 17, EEXIST },
+        { 18, EXDEV }, { 19, ENODEV }, { 20, ENOTDIR }, { 21, EISDIR },
+        { 22, EINVAL }, { 23, ENFILE }, { 24, EMFILE }, { 25, ENOTTY },
+        { 26, ETXTBSY }, { 27, EFBIG }, { 28, ENOSPC }, { 29, ESPIPE },
+        { 30, EROFS }, { 31, EMLINK }, { 32, EPIPE }, { 33, EDOM },
+        { 34, ERANGE }, { 35, EDEADLK }, { 36, ENAMETOOLONG },
+        { 37, ENOLCK }, { 38, ENOSYS }, { 39, ENOTEMPTY }, { 40, ELOOP },
+        { 61, ENODATA }, { 75, EOVERFLOW }, { 84, EILSEQ },
+        { 95, ENOTSUP }, { 95, EOPNOTSUPP }, { 116, ESTALE },
+        { 122, EDQUOT },
+    };
+
+    if (IsLinux()) {
+        return err;
+    }
+    for (i = 0; i < ARRAY_SIZE(map); i++) {
+        /* an errno the host lacks is 0 or all ones */
+        if (map[i].host_errno > 0 && err == map[i].host_errno) {
+            return map[i].linux_errno;
+        }
+    }
+    return err;
+}
+
+/* Linux xattr system calls on "/proc/self/fd/<dirfd>/name" (l* variants do not follow a final symlink); ENOTSUP elsewhere */
+static ssize_t cosmo_lgetxattr(const char *path, const char *name,
+                               void *value, size_t size)
+{
+    return cosmo_linux_syscall5(__NR_lgetxattr, (long)path, (long)name,
+                                (long)value, (long)size, 0);
+}
+
+static ssize_t cosmo_llistxattr(const char *path, char *list, size_t size)
+{
+    return cosmo_linux_syscall3(__NR_llistxattr, (long)path, (long)list,
+                                (long)size);
+}
+
+static int cosmo_lremovexattr(const char *path, const char *name)
+{
+    return cosmo_linux_syscall3(__NR_lremovexattr, (long)path, (long)name, 0);
+}
+
+static int cosmo_lsetxattr(const char *path, const char *name,
+                           const void *value, size_t size, int flags)
+{
+    return cosmo_linux_syscall5(__NR_lsetxattr, (long)path, (long)name,
+                                (long)value, (long)size, flags);
+}
+
+static char *proc_fd_path(int dirfd, const char *filename)
+{
+    return g_strdup_printf("/proc/self/fd/%d/%s", dirfd, filename);
+}
+
+ssize_t cosmo_fgetxattr(int fd, const char *name, void *value, size_t size)
+{
+    if (!IsLinux()) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    return cosmo_linux_syscall5(__NR_fgetxattr, fd, (long)name, (long)value,
+                                (long)size, 0);
+}
+
+ssize_t fgetxattrat_nofollow(int dirfd, const char *filename, const char *name,
+                             void *value, size_t size)
+{
+    char *proc_path;
+    ssize_t ret;
+
+    if (!IsLinux()) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    proc_path = proc_fd_path(dirfd, filename);
+    ret = cosmo_lgetxattr(proc_path, name, value, size);
+    g_free(proc_path);
+    return ret;
+}
+
+ssize_t flistxattrat_nofollow(int dirfd, const char *filename,
+                              char *list, size_t size)
+{
+    char *proc_path;
+    ssize_t ret;
+
+    if (!IsLinux()) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    proc_path = proc_fd_path(dirfd, filename);
+    ret = cosmo_llistxattr(proc_path, list, size);
+    g_free(proc_path);
+    return ret;
+}
+
+ssize_t fremovexattrat_nofollow(int dirfd, const char *filename,
+                                const char *name)
+{
+    char *proc_path;
+    ssize_t ret;
+
+    if (!IsLinux()) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    proc_path = proc_fd_path(dirfd, filename);
+    ret = cosmo_lremovexattr(proc_path, name);
+    g_free(proc_path);
+    return ret;
+}
+
+int fsetxattrat_nofollow(int dirfd, const char *filename, const char *name,
+                         void *value, size_t size, int flags)
+{
+    char *proc_path;
+    int ret;
+
+    if (!IsLinux()) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    proc_path = proc_fd_path(dirfd, filename);
+    ret = cosmo_lsetxattr(proc_path, name, value, size, flags);
+    g_free(proc_path);
+    return ret;
+}
+
+/* mknodat() is Linux-only; elsewhere only regular files (all the mapped models need) */
+int qemu_mknodat(int dirfd, const char *filename, mode_t mode, dev_t dev)
+{
+    int fd;
+
+    if (IsLinux()) {
+        return cosmo_linux_syscall5(__NR_mknodat, dirfd, (long)filename,
+                                    mode, dev, 0);
+    }
+    if (!S_ISREG(mode) && (mode & S_IFMT) != 0) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    fd = qemu_openat(dirfd, filename, O_CREAT | O_EXCL | O_WRONLY, mode & 07777);
+    if (fd < 0) {
+        return -1;
+    }
+    close(fd);
+    return 0;
+}
