+/*
+ * A library that gets loaded into the process must not come from a directory
+ * someone else could write to: require that the directory is ours, is not a
+ * symlink, and is closed to other users.  (Windows keeps %LOCALAPPDATA% private
+ * with its ACLs.)
+ */
+static bool sdl2_dir_is_private(const char *dir)
+{
+    struct stat st;
+
+    if (IsWindows()) {
+        return true;
+    }
+    if (lstat(dir, &st) < 0 || !S_ISDIR(st.st_mode) || st.st_uid != geteuid()) {
+        return false;
+    }
+    if ((st.st_mode & 0077) && chmod(dir, 0700) < 0) {
+        return false;
+    }
+    return true;
+}
+
+static bool sdl2_file_has_digest(const char *path, const char *hex)
+{
+    struct stat st;
+    char *data = NULL, *got = NULL;
+    gsize len;
+    bool same = false;
+
+    if (lstat(path, &st) < 0 || !S_ISREG(st.st_mode)) {
+        return false;
+    }
+    if (g_file_get_contents(path, &data, &len, NULL) &&
+        qcrypto_hash_digest(QCRYPTO_HASH_ALGO_SHA256, data, len, &got,
+                            NULL) == 0) {
+        same = !strcmp(got, hex);
+    }
+    g_free(data);
+    g_free(got);
+    return same;
+}
+
+static bool sdl2_write_file(const char *path, const char *data, gsize len)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0600);
+    gsize done = 0;
+
+    if (fd < 0) {
+        return false;
+    }
+    while (done < len) {
+        ssize_t n = write(fd, data + done, len - done);
+
+        if (n <= 0) {
+            close(fd);
+            return false;
+        }
+        done += n;
+    }
+    return close(fd) == 0;
+}
+
+/*
+ * Makes the embedded SDL2 library available as a file and returns its path
+ * (to be freed), or NULL with the reason appended to @why.  The file is named
+ * after its SHA-256, so different versions never collide, and is only reused if
+ * its contents still match: a changed or planted file is replaced.  It is
+ * written under a temporary name and renamed, so a concurrent QEMU never sees a
+ * partial file.
+ *
+ * QEMU_COSMO_SDL2_BUNDLE=<file> stands in for the embedded library (the build
+ * embeds none on Linux); it exists so this code can be tested there.
+ */
+static char *sdl2_bundled_library(GString *why)
+{
+    const char *override = getenv("QEMU_COSMO_SDL2_BUNDLE");
+    const char *embedded = IsWindows() ? SDL2_EMBEDDED_WINDOWS :
+                           IsXnu() ? SDL2_EMBEDDED_MACOS : NULL;
+    const char *ext = IsWindows() ? ".dll" : IsXnu() ? ".dylib" : ".so";
+    char *src = NULL, *data = NULL, *hex = NULL, *cache, *dir = NULL;
+    char *final = NULL, *tmp = NULL;
+    gsize len;
+
+    if (override && *override) {
+        src = g_strdup(override);
+    } else if (embedded) {
+        src = qemu_find_file(QEMU_FILE_TYPE_BIOS, embedded);
+    }
+    if (!src) {
+        return NULL;
+    }
+    if (!g_file_get_contents(src, &data, &len, NULL) ||
+        qcrypto_hash_digest(QCRYPTO_HASH_ALGO_SHA256, data, len, &hex,
+                            NULL) < 0) {
+        g_string_append_printf(why, "%scannot read the embedded SDL2 (%s)",
+                               why->len ? "; " : "", src);
+        goto out;
+    }
+    cache = sdl2_user_cache_dir();
+    if (!cache) {
+        g_string_append_printf(why, "%sno user cache directory (no HOME)",
+                               why->len ? "; " : "");
+        goto out;
+    }
+    dir = g_build_filename(cache, "sdl2", NULL);
+    g_free(cache);
+    if (g_mkdir_with_parents(dir, 0700) < 0 || !sdl2_dir_is_private(dir)) {
+        g_string_append_printf(why, "%scache directory %s is not usable",
+                               why->len ? "; " : "", dir);
+        goto out;
+    }
+
+    final = g_strdup_printf("%s/SDL2-%.16s%s", dir, hex, ext);
+    if (!sdl2_file_has_digest(final, hex)) {
+        tmp = g_strdup_printf("%s.%d.tmp", final, (int)getpid());
+        if (!sdl2_write_file(tmp, data, len) || rename(tmp, final) < 0) {
+            unlink(tmp);
+            /* another instance may have just installed it, or still use it */
+            if (!sdl2_file_has_digest(final, hex)) {
+                g_string_append_printf(why, "%scannot write %s",
+                                       why->len ? "; " : "", final);
+                g_free(final);
+                final = NULL;
+            }
+        }
+    }
+out:
+    g_free(src);
+    g_free(data);
+    g_free(hex);
+    g_free(dir);
+    g_free(tmp);
+    return final;
+}
+
+static void *sdl2_try(const char *path, GString *tried)
+{
+    char *native = g_strdup(path);
+    void *lib;
+
+    if (IsWindows() && strchr(path, '/')) {
+        /* LoadLibrary wants backslashes in a path */
+        g_strdelimit(native, "/", '\\');
+    }
+    lib = cosmo_dlopen(native, RTLD_NOW);
+    if (!lib) {
+        g_string_append_printf(tried, "%s%s: %s", tried->len ? "; " : "",
+                               path, cosmo_dlerror());
+    }
+    g_free(native);
+    return lib;
+}
