+/*
+ * Per-user cache directory: %LOCALAPPDATA%\qemu-cosmo\Cache, ~/Library/Caches/qemu-cosmo,
+ * or $XDG_CACHE_HOME (~/.cache) /qemu-cosmo. NULL if there is no home.
+ */
+static char *sdl2_user_cache_dir(void)
+{
+    const char *base;
+    char *home, *dir = NULL;
+
+    if (IsWindows()) {
+        base = getenv("LOCALAPPDATA");
+        if (base && *base) {
+            dir = g_build_filename(base, SDL2_APP_NAME, "Cache", NULL);
+        } else if ((home = sdl2_home_dir())) {
+            dir = g_build_filename(home, "AppData", "Local", SDL2_APP_NAME,
+                                   "Cache", NULL);
+            g_free(home);
+        }
+    } else if (IsXnu()) {
+        if ((home = sdl2_home_dir())) {
+            dir = g_build_filename(home, "Library", "Caches", SDL2_APP_NAME,
+                                   NULL);
+            g_free(home);
+        }
+    } else {
+        base = getenv("XDG_CACHE_HOME");
+        if (base && g_path_is_absolute(base)) {
+            dir = g_build_filename(base, SDL2_APP_NAME, NULL);
+        } else if ((home = sdl2_home_dir())) {
+            dir = g_build_filename(home, ".cache", SDL2_APP_NAME, NULL);
+            g_free(home);
+        }
+    }
+    if (dir && IsWindows()) {
+        /* Cosmopolitan accepts either separator; keep one for glib */
+        g_strdelimit(dir, "\\", '/');
+    }
+    return dir;
+}
