+static char *sdl2_home_dir(void)
+{
+    const char *home = getenv("HOME");
+
+    if ((!home || !*home) && IsWindows()) {
+        home = getenv("USERPROFILE");
+    }
+    return (home && *home) ? g_strdup(home) : NULL;
