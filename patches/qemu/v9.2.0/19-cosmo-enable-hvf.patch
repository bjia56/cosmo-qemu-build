diff --git a/accel/hvf/hvf-cosmo.c b/accel/hvf/hvf-cosmo.c
new file mode 100644
index 0000000..f086aa7
--- /dev/null
+++ b/accel/hvf/hvf-cosmo.c
@@ -0,0 +1,86 @@
+/*
+ * Loading Hypervisor.framework at run time, for the Cosmopolitan build.
+ *
+ * The framework cannot be linked into a Cosmopolitan executable, so every
+ * hv_*() function the accelerator uses is looked up with cosmo_dlsym() when
+ * the accelerator is initialized (see compat/hvf/Hypervisor/Hypervisor.h).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include <cosmo.h>
+#include <dlfcn.h>
+
+#define HVF_NO_REDIRECT
+#include <Hypervisor/Hypervisor.h>
+
+#define HVF_FRAMEWORK "/System/Library/Frameworks/Hypervisor.framework/Hypervisor"
+#define HVF_LIBSYSTEM "/usr/lib/libSystem.B.dylib"
+
+struct HVFDispatch hvf_dispatch;
+
+void hvf_cosmo_not_loaded(void)
+{
+    error_report("HVF: Hypervisor.framework used before it was loaded");
+    abort();
+}
+
+static bool hvf_bind(void *lib, const char *name, void **slot, Error **errp)
+{
+    void *sym = cosmo_dlsym(lib, name);
+
+    if (!sym) {
+        error_setg(errp, "HVF: %s not found in Hypervisor.framework "
+                   "(macOS 13 or later is required)", name);
+        return false;
+    }
+    *slot = cosmo_dltramp(sym);
+    if (!*slot) {
+        error_setg(errp, "HVF: cannot create a call thunk for %s", name);
+        return false;
+    }
+    return true;
+}
+
+bool hvf_cosmo_load(Error **errp)
+{
+    void *framework, *libsystem;
+
+    if (hvf_dispatch.loaded) {
+        return true;
+    }
+    if (!IsXnuSilicon()) {
+        error_setg(errp, "HVF is only available on macOS with Apple Silicon");
+        return false;
+    }
+    framework = cosmo_dlopen(HVF_FRAMEWORK, RTLD_NOW);
+    if (!framework) {
+        error_setg(errp, "HVF: cannot load Hypervisor.framework: %s",
+                   cosmo_dlerror());
+        return false;
+    }
+    libsystem = cosmo_dlopen(HVF_LIBSYSTEM, RTLD_NOW);
+    if (!libsystem) {
+        error_setg(errp, "HVF: cannot load libSystem: %s", cosmo_dlerror());
+        return false;
+    }
+
+#define HVF_BIND(ret, name, args) \
+    if (!hvf_bind(framework, #name, (void **)&hvf_dispatch.name, errp)) { \
+        return false; \
+    }
+    HVF_FUNCTIONS(HVF_BIND)
+#undef HVF_BIND
+#define HVF_BIND(ret, name, args) \
+    if (!hvf_bind(libsystem, #name, (void **)&hvf_dispatch.name, errp)) { \
+        return false; \
+    }
+    HVF_SYSTEM_FUNCTIONS(HVF_BIND)
+#undef HVF_BIND
+
+    hvf_dispatch.loaded = true;
+    return true;
+}
