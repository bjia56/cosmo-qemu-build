diff --git a/util/mmap-alloc.c b/util/mmap-alloc.c
index 6feb3d2..85fed34 100644
--- a/util/mmap-alloc.c
+++ b/util/mmap-alloc.c
@@ -21,6 +21,9 @@
 #endif /* CONFIG_LINUX */
 
 #include "qemu/osdep.h"
+#ifdef __COSMOPOLITAN__
+#include <cosmo.h>
+#endif
 #include "qemu/mmap-alloc.h"
 #include "qemu/host-utils.h"
 #include "qemu/cutils.h"
@@ -251,6 +254,36 @@ static inline size_t mmap_guard_pagesize(int fd)
 #endif
 }
 
+#ifdef __COSMOPOLITAN__
+/*
+ * Windows can only unmap or replace whole allocations, so the reserve/carve/trim
+ * sequence below cannot work: map directly (granularity-aligned, no guard page).
+ */
+static size_t qemu_ram_windows_size(size_t size)
+{
+    return QEMU_ALIGN_UP(size, (size_t)getgransize());
+}
+
+static void *qemu_ram_mmap_windows(int fd, size_t size, size_t align,
+                                   uint32_t qemu_map_flags, off_t map_offset)
+{
+    const bool readonly = qemu_map_flags & QEMU_MAP_READONLY;
+    const bool shared = qemu_map_flags & QEMU_MAP_SHARED;
+    const int prot = PROT_READ | (readonly ? 0 : PROT_WRITE);
+    const int flags = (fd == -1 ? MAP_ANONYMOUS : 0) |
+                      (shared ? MAP_SHARED : MAP_PRIVATE);
+    void *ptr = mmap(NULL, qemu_ram_windows_size(size), prot, flags, fd,
+                     map_offset);
+
+    if (ptr != MAP_FAILED && !QEMU_IS_ALIGNED((uintptr_t)ptr, align)) {
+        munmap(ptr, qemu_ram_windows_size(size));
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    return ptr;
+}
+#endif
+
 void *qemu_ram_mmap(int fd,
                     size_t size,
                     size_t align,
@@ -261,6 +294,13 @@ void *qemu_ram_mmap(int fd,
     size_t offset, total;
     void *ptr, *guardptr;
 
+#ifdef __COSMOPOLITAN__
+    if (IsWindows()) {
+        return qemu_ram_mmap_windows(fd, size, align, qemu_map_flags,
+                                     map_offset);
+    }
+#endif
+
     /*
      * Note: this always allocates at least one extra page of virtual address
      * space, even if size is already aligned.
@@ -304,6 +344,12 @@ void *qemu_ram_mmap(int fd,
 void qemu_ram_munmap(int fd, void *ptr, size_t size)
 {
     if (ptr) {
+#ifdef __COSMOPOLITAN__
+        if (IsWindows()) {
+            munmap(ptr, qemu_ram_windows_size(size));
+            return;
+        }
+#endif
         /* Unmap both the RAM block and the guard page */
         munmap(ptr, size + mmap_guard_pagesize(fd));
     }
