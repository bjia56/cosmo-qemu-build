diff --git a/hw/9pfs/9p.c b/hw/9pfs/9p.c
index 5785177..7687f24 100644
--- a/hw/9pfs/9p.c
+++ b/hw/9pfs/9p.c
@@ -4353,6 +4353,14 @@ static void __attribute__((__constructor__)) v9fs_set_fd_limit(void)
 {
     struct rlimit rlim;
     if (getrlimit(RLIMIT_NOFILE, &rlim) < 0) {
+#ifdef __COSMOPOLITAN__
+        if (errno == EINVAL) {
+            /* Windows has no such limit and cosmopolitan reports EINVAL */
+            open_fd_hw = 1024 - 400;
+            open_fd_rc = 1024 / 2;
+            return;
+        }
+#endif
         error_report("Failed to get the resource limit");
         exit(1);
     }
