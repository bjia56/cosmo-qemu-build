diff --git a/include/qemu/cosmo-linux-syscall.h b/include/qemu/cosmo-linux-syscall.h
new file mode 100644
index 0000000..0cb6af9
--- /dev/null
+++ b/include/qemu/cosmo-linux-syscall.h
@@ -0,0 +1,54 @@
+/*
+ * Raw Linux system calls for cosmopolitan builds.
+ *
+ * cosmopolitan's syscall() only emulates a few calls and has no wrapper for
+ * many Linux-only ones (eventfd2, arch_prctl, ...).  When the binary is running
+ * on Linux, issue the system call directly; on any other OS fail with ENOSYS.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef QEMU_COSMO_LINUX_SYSCALL_H
+#define QEMU_COSMO_LINUX_SYSCALL_H
+
+#ifdef __COSMOPOLITAN__
+
+#include <cosmo.h>
+#include <errno.h>
+
+/* Returns the (non-negative) result, or -1 with errno set. */
+static inline long cosmo_linux_syscall3(long nr, long a, long b, long c)
+{
+    long ret;
+
+    if (!IsLinux()) {
+        errno = ENOSYS;
+        return -1;
+    }
+#if defined(__x86_64__)
+    __asm__ volatile("syscall"
+                     : "=a"(ret)
+                     : "a"(nr), "D"(a), "S"(b), "d"(c)
+                     : "rcx", "r11", "memory");
+#elif defined(__aarch64__)
+    register long x8 __asm__("x8") = nr;
+    register long x0 __asm__("x0") = a;
+    register long x1 __asm__("x1") = b;
+    register long x2 __asm__("x2") = c;
+    __asm__ volatile("svc #0" : "+r"(x0) : "r"(x8), "r"(x1), "r"(x2) : "memory");
+    ret = x0;
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+    if (ret < 0 && ret > -4096) {
+        errno = -ret;
+        return -1;
+    }
+    return ret;
+}
+
+#endif /* __COSMOPOLITAN__ */
+
+#endif /* QEMU_COSMO_LINUX_SYSCALL_H */
diff --git a/util/event_notifier-posix.c b/util/event_notifier-posix.c
index 76420c5..4b5085a 100644
--- a/util/event_notifier-posix.c
+++ b/util/event_notifier-posix.c
@@ -19,6 +19,30 @@
 #include <sys/eventfd.h>
 #endif
 
+#ifdef __COSMOPOLITAN__
+#include "qemu/cosmo-linux-syscall.h"
+
+/*
+ * cosmopolitan has no eventfd(): issue eventfd2 directly when running on
+ * Linux.  Elsewhere this fails with ENOSYS and the pipe fallback below is used.
+ */
+static int cosmo_eventfd(void)
+{
+#if defined(__x86_64__)
+# define COSMO_NR_EVENTFD2 290
+#elif defined(__aarch64__)
+# define COSMO_NR_EVENTFD2 19
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+#ifdef COSMO_NR_EVENTFD2
+    /* EFD_NONBLOCK | EFD_CLOEXEC, as raw Linux values */
+    return cosmo_linux_syscall3(COSMO_NR_EVENTFD2, 0, 04000L | 02000000L, 0);
+#endif
+}
+#endif
+
 #ifdef CONFIG_EVENTFD
 /*
  * Initialize @e with existing file descriptor @fd.
@@ -39,6 +63,8 @@ int event_notifier_init(EventNotifier *e, int active)
 
 #ifdef CONFIG_EVENTFD
     ret = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+#elif defined(__COSMOPOLITAN__)
+    ret = cosmo_eventfd();
 #else
     ret = -1;
     errno = ENOSYS;
