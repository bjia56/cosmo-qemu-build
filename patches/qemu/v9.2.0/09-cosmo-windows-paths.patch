+/*
+ * Cosmopolitan's open() and friends take Windows paths ("C:\dir\file", with
+ * either kind of slash) when running on Windows, but QEMU only knows about
+ * them under _WIN32. Without this, "C:\dir\file" is read as protocol "C".
+ */
+static bool cosmo_win_drive_prefix(const char *path)
+{
+    return IsWindows() &&
+           ((path[0] >= 'a' && path[0] <= 'z') ||
+            (path[0] >= 'A' && path[0] <= 'Z')) &&
+           path[1] == ':';
+}
+#endif
