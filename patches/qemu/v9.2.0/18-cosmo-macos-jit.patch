diff --git a/include/qemu/osdep.h b/include/qemu/osdep.h
index fdff07f..ba85535 100644
--- a/include/qemu/osdep.h
+++ b/include/qemu/osdep.h
@@ -811,6 +811,12 @@ static inline void qemu_thread_jit_write(void)
 {
     pthread_jit_write_protect_np(false);
 }
+#elif defined(__COSMOPOLITAN__)
+/* No-ops except on Apple Silicon, where Cosmopolitan toggles the JIT pages */
+void __jit_begin(void);
+void __jit_end(void);
+static inline void qemu_thread_jit_write(void) { __jit_begin(); }
+static inline void qemu_thread_jit_execute(void) { __jit_end(); }
 #else
 static inline void qemu_thread_jit_write(void) {}
 static inline void qemu_thread_jit_execute(void) {}
diff --git a/tcg/region.c b/tcg/region.c
index 478ec05..6309ffd 100644
--- a/tcg/region.c
+++ b/tcg/region.c
@@ -716,6 +716,12 @@ static int alloc_code_gen_buffer(size_t size, int splitwx, Error **errp)
         flags |= MAP_JIT;
     }
 #endif
+#ifdef __COSMOPOLITAN__
+    /* MAP_JIT is a runtime value: nonzero on macOS only */
+    if (!splitwx) {
+        flags |= MAP_JIT;
+    }
+#endif
 
     return alloc_code_gen_buffer_anon(size, prot, flags, errp);
 }
