--- a/util/event_notifier-posix.c
+++ b/util/event_notifier-posix.c
@@ -20,6 +20,10 @@
 #endif
 
 #ifdef __COSMOPOLITAN__
+#include <cosmo.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
 #include "qemu/cosmo-linux-syscall.h"
 
 /*
@@ -41,6 +45,58 @@
     return cosmo_linux_syscall3(COSMO_NR_EVENTFD2, 0, 04000L | 02000000L, 0);
 #endif
 }
+
+/*
+ * On Windows, Cosmopolitan's poll() cannot wait for data on a pipe: it peeks
+ * the pipe and sleeps POLL_INTERVAL_MS (10 ms, which Windows rounds up to its
+ * 15.6 ms timer tick). The main loop then noticed a notification only once
+ * per tick, and every completed block request (a thread pool worker
+ * notifying the main loop) cost one: reading a CD-ROM image took 15.6 ms per
+ * 2 KiB. Sockets are waited on in WSAPoll() and wake up at once, so use a
+ * connected loopback TCP pair there: fds[0] reads, fds[1] writes.
+ */
+static bool cosmo_win_notifier_pair(int fds[2])
+{
+    struct sockaddr_in addr = { .sin_family = AF_INET };
+    socklen_t len = sizeof(addr);
+    int one = 1, lfd, cfd = -1, afd = -1, saved;
+
+    addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    lfd = socket(AF_INET, SOCK_STREAM, 0);
+    if (lfd < 0) {
+        return false;
+    }
+    if (bind(lfd, (struct sockaddr *)&addr, sizeof(addr)) < 0 ||
+        listen(lfd, 1) < 0 ||
+        getsockname(lfd, (struct sockaddr *)&addr, &len) < 0) {
+        goto fail;
+    }
+    cfd = socket(AF_INET, SOCK_STREAM, 0);
+    if (cfd < 0 || connect(cfd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
+        goto fail;
+    }
+    afd = accept(lfd, NULL, NULL);
+    if (afd < 0) {
+        goto fail;
+    }
+    close(lfd);
+    setsockopt(afd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    setsockopt(cfd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    qemu_set_cloexec(afd);
+    qemu_set_cloexec(cfd);
+    fds[0] = afd;
+    fds[1] = cfd;
+    return true;
+
+fail:
+    saved = errno;
+    close(lfd);
+    if (cfd >= 0) {
+        close(cfd);
+    }
+    errno = saved;
+    return false;
+}
 #endif
 
 #ifdef CONFIG_EVENTFD
@@ -75,6 +131,13 @@
         if (errno != ENOSYS) {
             return -errno;
         }
+#ifdef __COSMOPOLITAN__
+        if (IsWindows()) {
+            if (!cosmo_win_notifier_pair(fds)) {
+                return -errno;
+            }
+        } else
+#endif
         if (!g_unix_open_pipe(fds, FD_CLOEXEC, NULL)) {
             return -errno;
         }
