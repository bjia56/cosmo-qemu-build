+#include <cosmo.h>
+#include <dlfcn.h>
+
+typedef void *HMODULE;
+
+static HMODULE cosmo_load_library(const char *name)
+{
+    return IsWindows() ? cosmo_dlopen(name, RTLD_NOW) : NULL;
+}
+
+/* cosmo_dltramp() would happily wrap NULL, and callers test for NULL */
+static void *cosmo_get_proc(HMODULE lib, const char *name)
+{
+    void *fn = cosmo_dlsym(lib, name);
+    return fn ? cosmo_dltramp(fn) : NULL;
+}
+
+#define LoadLibrary(name) cosmo_load_library(name)
+#define GetProcAddress(lib, name) cosmo_get_proc(lib, name)
+#define FreeLibrary(lib) cosmo_dlclose(lib)
