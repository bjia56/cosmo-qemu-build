diff --git a/meson.build b/meson.build
index ac84d95..fdf49f1 100644
--- a/meson.build
+++ b/meson.build
@@ -850,8 +850,17 @@ endif
 
 hvf = not_found
 if get_option('hvf').allowed()
-  hvf = dependency('appleframeworks', modules: 'Hypervisor',
-                   required: get_option('hvf'))
+  if host_os == 'cosmopolitan'
+    # Hypervisor.framework is loaded at run time (accel/hvf/hvf-cosmo.c); only
+    # its arm64 interface exists, and only Apple Silicon can load it
+    if host_machine.cpu() == 'aarch64' and \
+       cc.has_header('Hypervisor/Hypervisor.h', required: get_option('hvf'))
+      hvf = declare_dependency()
+    endif
+  else
+    hvf = dependency('appleframeworks', modules: 'Hypervisor',
+                     required: get_option('hvf'))
+  endif
   if hvf.found()
     accelerators += 'CONFIG_HVF'
   endif
