--- a/target/i386/whpx/whpx-all.c
+++ b/target/i386/whpx/whpx-all.c
@@ -585,6 +585,40 @@
     return;
 }
 
+/*
+ * With the Hyper-V APIC, a vCPU that executed HLT stays halted inside the
+ * hypervisor. An interrupt requested with WHvRequestInterrupt (MSIs, and so
+ * the IO-APIC and the LAPIC timer) wakes it, but the external interrupt we
+ * queue for the PIC through WHvRegisterPendingEvent does not: a BIOS or
+ * bootloader idling in HLT, such as ISOLINUX at its "boot:" prompt, then
+ * never sees the timer tick, and the PIC is left with IRQ0 in service. Clear
+ * the halt state ourselves when injecting such an interrupt (as upstream QEMU
+ * later did, in whpx_vcpu_kick_out_of_hlt()).
+ */
+static void whpx_vcpu_kick_out_of_hlt(CPUState *cpu)
+{
+    WHV_REGISTER_NAME name = WHvRegisterInternalActivityState;
+    WHV_REGISTER_VALUE value;
+    HRESULT hr;
+    struct whpx_state *whpx = &whpx_global;
+
+    hr = whp_dispatch.WHvGetVirtualProcessorRegisters(
+        whpx->partition, cpu->cpu_index, &name, 1, &value);
+    if (FAILED(hr)) {
+        error_report("WHPX: Failed to get the activity state, hr=%08x", hr);
+        return;
+    }
+
+    if (value.InternalActivity.HaltSuspend) {
+        value.InternalActivity.HaltSuspend = 0;
+        hr = whp_dispatch.WHvSetVirtualProcessorRegisters(
+            whpx->partition, cpu->cpu_index, &name, 1, &value);
+        if (FAILED(hr)) {
+            error_report("WHPX: Failed to clear the halt state, hr=%08x", hr);
+        }
+    }
+}
+
 static int whpx_get_tsc(CPUState *cpu)
 {
     WHV_REGISTER_NAME tsc_reg = WHvX64RegisterTsc;
@@ -1565,6 +1599,7 @@
                 .Vector = irq,
             };
             reg_count += 1;
+            whpx_vcpu_kick_out_of_hlt(cpu);
         }
      }
 
