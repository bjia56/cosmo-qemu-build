--- a/ape-m1.c
+++ b/ape-m1.c
@@ -43,6 +43,169 @@
 #include <time.h>
 #include <unistd.h>
 
+/*
+ * cosmo-qemu-build: sign this loader with the com.apple.security.hypervisor entitlement
+ * (required by Hypervisor.framework). The loader file is private to this build, so signing
+ * it affects nothing else. If the process lacks the entitlement and the file does not have
+ * it either, copy, ad-hoc sign, rename over the loader and re-exec; silent on failure.
+ */
+#include <mach-o/dyld.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+
+extern char **environ;
+
+static const char QsPlist[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+    "<plist version=\"1.0\">\n"
+    "<dict>\n"
+    "  <key>com.apple.security.hypervisor</key>\n"
+    "  <true/>\n"
+    "</dict>\n"
+    "</plist>\n";
+
+#define QS_ENTITLEMENT "com.apple.security.hypervisor"
+#define QS_CS_OPS_ENTITLEMENTS_BLOB 7
+#define QS_CS_OPS_DER_ENTITLEMENTS_BLOB 16
+
+int csops(int pid, unsigned int ops, void *useraddr, size_t usersize);
+
+/* asks the kernel, which has the entitlements as a plist and in DER form */
+static int QsProcessHasEntitlement(void) {
+  static char blob[65536];
+  static const unsigned ops[] = {QS_CS_OPS_ENTITLEMENTS_BLOB,
+                                 QS_CS_OPS_DER_ENTITLEMENTS_BLOB};
+  size_t n;
+  unsigned i;
+  for (i = 0; i < sizeof(ops) / sizeof(ops[0]); ++i) {
+    if (csops(getpid(), ops[i], blob, sizeof(blob)))
+      continue;
+    /* big-endian magic and length, then the entitlements */
+    n = ((size_t)(unsigned char)blob[4] << 24) | ((size_t)(unsigned char)blob[5] << 16) |
+        ((size_t)(unsigned char)blob[6] << 8) | (size_t)(unsigned char)blob[7];
+    if (n >= 8 && n <= sizeof(blob) &&
+        memmem(blob + 8, n - 8, QS_ENTITLEMENT, sizeof(QS_ENTITLEMENT) - 1))
+      return 1;
+  }
+  return 0;
+}
+
+/* exclusive, no symlinks: a shared TMPDIR must not allow overwriting other files */
+static int QsWriteFile(const char *path, const void *data, size_t size) {
+  int fd, ok;
+  if ((fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)) == -1)
+    return -1;
+  ok = write(fd, data, size) == (ssize_t)size;
+  return (close(fd) == 0 && ok) ? 0 : -1;
+}
+
+static int QsCopyFile(const char *from, const char *to) {
+  int in, out, ok = 0;
+  ssize_t n;
+  char buf[65536];
+  if ((in = open(from, O_RDONLY)) == -1)
+    return -1;
+  if ((out = open(to, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0700)) == -1) {
+    close(in);
+    return -1;
+  }
+  while ((n = read(in, buf, sizeof(buf))) > 0) {
+    if (write(out, buf, n) != n) {
+      n = -1;
+      break;
+    }
+  }
+  ok = n == 0;
+  close(in);
+  if (close(out))
+    ok = 0;
+  return ok ? fchmodat(AT_FDCWD, to, 0755, 0) : -1;
+}
+
+static int QsRun(char *const argv[]) {
+  pid_t pid;
+  int rc, status;
+  posix_spawn_file_actions_t fa;
+  if (posix_spawn_file_actions_init(&fa))
+    return -1;
+  posix_spawn_file_actions_addopen(&fa, 1, "/dev/null", O_WRONLY, 0);
+  posix_spawn_file_actions_addopen(&fa, 2, "/dev/null", O_WRONLY, 0);
+  rc = posix_spawn(&pid, argv[0], &fa, 0, argv, environ);
+  posix_spawn_file_actions_destroy(&fa);
+  if (rc)
+    return -1;
+  if (waitpid(pid, &status, 0) == -1)
+    return -1;
+  return WIFEXITED(status) && WEXITSTATUS(status) == 0 ? 0 : -1;
+}
+
+static int QsFileHasEntitlement(const char *path) {
+  static char out[65536];
+  size_t n = 0;
+  ssize_t r;
+  int fds[2], status, found;
+  pid_t pid;
+  posix_spawn_file_actions_t fa;
+  char *const cmd[] = {"/usr/bin/codesign", "-d", "--entitlements", "-", (char *)path, 0};
+  if (pipe(fds))
+    return 0;
+  if (posix_spawn_file_actions_init(&fa)) {
+    close(fds[0]);
+    close(fds[1]);
+    return 0;
+  }
+  posix_spawn_file_actions_adddup2(&fa, fds[1], 1);
+  posix_spawn_file_actions_addopen(&fa, 2, "/dev/null", O_WRONLY, 0);
+  posix_spawn_file_actions_addclose(&fa, fds[0]);
+  posix_spawn_file_actions_addclose(&fa, fds[1]);
+  found = posix_spawn(&pid, cmd[0], &fa, 0, cmd, environ);
+  posix_spawn_file_actions_destroy(&fa);
+  close(fds[1]);
+  if (found) {
+    close(fds[0]);
+    return 0;
+  }
+  while (n < sizeof(out) && (r = read(fds[0], out + n, sizeof(out) - n)) > 0)
+    n += r;
+  close(fds[0]);
+  waitpid(pid, &status, 0);
+  return memmem(out, n, QS_ENTITLEMENT, sizeof(QS_ENTITLEMENT) - 1) != 0;
+}
+
+static void QsEnsureEntitlement(char **argv) {
+  uint32_t size;
+  char path[PATH_MAX], self[PATH_MAX];
+  char tmp[PATH_MAX + 32], plist[PATH_MAX + 32];
+  if (QsProcessHasEntitlement())
+    return;
+  size = sizeof(path);
+  if (_NSGetExecutablePath(path, &size) || !realpath(path, self))
+    return;
+  if (QsFileHasEntitlement(self))
+    return; /* signed already */
+  snprintf(tmp, sizeof(tmp), "%s.tmp.%d", self, (int)getpid());
+  snprintf(plist, sizeof(plist), "%s.plist.%d", self, (int)getpid());
+  char *const cmd[] = {"/usr/bin/codesign", "--force", "-s", "-",
+                       "--entitlements",    plist,     tmp,  0};
+  if (QsWriteFile(plist, QsPlist, sizeof(QsPlist) - 1) || QsCopyFile(self, tmp) ||
+      QsRun(cmd)) {
+    unlink(plist);
+    unlink(tmp);
+    return;
+  }
+  unlink(plist);
+  if (rename(tmp, self)) {
+    unlink(tmp);
+    return;
+  }
+  execv(self, argv);
+}
+
 #define pagesz 16384
 /* maximum path size that cosmo can take */
 #define PATHSIZE       (PATH_MAX < 1024 ? PATH_MAX : 1024)
@@ -943,6 +1106,8 @@
   union ElfEhdrBuf *ebuf;
   char *p, *pe, *exe, *prog, *execfn;
 
+  QsEnsureEntitlement(argv);
+
   /* allocate loader memory in program's arg block */
   n = sizeof(struct ApeLoader);
   M = (struct ApeLoader *)__builtin_alloca(n);
